# Rendered by the nginx image at start-up: ${API_UPSTREAM} comes from the environment.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Same-origin API: the browser calls /api/..., nginx forwards to the backend
    # with the prefix stripped, so no CORS is needed.
    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        proxy_pass ${API_UPSTREAM}/;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 60s; # the assistant can take a few seconds
    }

    # Hashed build files (vite build.assetsDir = "static") never change.
    # Not /assets/: that path belongs to the app's own asset pages.
    location /static/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Client-side routes (/assets/12, /people...) all serve index.html, which is
    # never cached so a deploy is picked up on the next load.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
